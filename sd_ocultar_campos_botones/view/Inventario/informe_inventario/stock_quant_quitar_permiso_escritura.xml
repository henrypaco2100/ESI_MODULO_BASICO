<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de Inventario costo de destino-->
<odoo>
   <data>
        <record model="ir.ui.view" id="stock_quant_quitar_permiso_de_write">
                <field name="name">stock.quant.quitar.permiso.de.write</field>
                <field name="model">stock.quant</field>
                <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
                <field name="arch" type="xml">
                    <!-- ocultamos los campos "ubicacion origen" y "ubicacion destino"-->
                    <xpath expr="//field[@name='inventory_quantity']" position="attributes">
                            <attribute name='readonly'>1</attribute>
                    </xpath>
                </field>
        </record>
    </data>
</odoo>
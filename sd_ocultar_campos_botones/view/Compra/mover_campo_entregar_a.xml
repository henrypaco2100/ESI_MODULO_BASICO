<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de Ventas MOVER EL CAMPO "entregar a" -->
<odoo>
   <data>
    <record model="ir.ui.view" id="sale_order_mover_campo_entregar">
            <field name="name">purchase.order.mover.campo.entregar</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                     <field name="picking_type_id" domain="[('code','=','incoming'), '|', ('warehouse_id', '=', False), ('warehouse_id.company_id', '=', company_id)]" options="{'no_create': True}" groups="stock.group_stock_multi_locations"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
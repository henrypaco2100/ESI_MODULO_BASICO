<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de Ventas-Facturas-->
<odoo>
   <data>
    <record model="ir.ui.view" id="sale_order_modificar_enviar_imprimir">
            <field name="name">account.move.modificar.enviar.imprimir</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_invoice_sent']" position="attributes">
                    <attribute name='class'>btn-light</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
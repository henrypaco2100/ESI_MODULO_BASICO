<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de Ventas MOVER EL CAMPO ALMACEN -->
<odoo>
   <data>
    <record model="ir.ui.view" id="sale_order_mover_campo_almacen">
            <field name="name">sale.order.mover.campo.almacen</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                      <field name="warehouse_id" options="{'no_create': True}" groups="stock.group_stock_multi_warehouses" force_save="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
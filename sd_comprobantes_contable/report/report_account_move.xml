<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sd_report_account_move_comprobante_contable">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="account_move">
                <t t-call="sd_comprobantes_contable.sd_internal_layout_account_move_comprobante">
                    <div class="header" style="border:1px solid #000000;font-size: 12px; height:130px">
                        <div style="width:40%; height:15px;margin-left:1%;float:left">
                            <strong><div><span t-esc="account_move.company_id.name"/></div></strong>
                        </div>
                        <div style="width:30%; height:15px;float:left">
                            <div>Nit:<span style="width:100%; height:50%" t-esc="account_move.company_id.partner_id.vat"/></div>
                        </div>
                        <div style="width:25%; height:15px;float:right;margin-top:1px;margin-right:2px">
                            <center style="text-align:right;">Página <span class="page"/> de <span class="topage"/></center>
                        </div>
                        <div style="width:100%; height:35px;font-size: 18px;font-weight: bold;">
                            <center><div t-esc="account_move.get_title_report_comprobante()"/></center>
                        </div>
                        <br/>
                        <div style="width:100%; height:20px;">
                            <div style="width:40%; height:100%;float:left;margin-left:1%;">
                                <div>FECHA: <span t-esc="account_move.fecha_a_palabras()"/></div>
                            </div>
                            <div style="width:30%; height:100%;float:left;">
                                <div>Expresado en <span t-esc="account_move.currency_id.currency_unit_label"/></div>
                            </div>
                            <div style="width:15%; height:100%;float:right;text-align:right;margin-right:2px">
                                <span t-esc="account_move.env.user.partner_id.name"/>
                            </div>
                        </div>
                        <div style="width:100%; height:35px;">
                            <div style="width:50%; height:100%;float:left;margin-left:1%;line-height:95%">
                                <div>DIARIO: <span t-esc="account_move.journal_id.display_name"/></div>
                            </div>
                            <div style="width:40%; height:50%;float:left;margin-left:5%">
                                <div>T/C: <span t-esc="account_move.get_tasa_cambio()"/></div>
                            </div>
                        </div>

                        <!-- ESI correccion 2026-09-01:
                             Cabecera dinamica. CTA Flujo y Analitica solo se imprimen
                             cuando se marca la opcion correspondiente en account.move. -->
                        <table style="width:100%; table-layout:fixed; border-collapse:collapse; border-top:1px solid #000000; font-size:11px; text-align:center;">
                            <colgroup>
                                <col style="width:17%"/>
                                <col style="width:11%"/>
                                <col style="width:18%"/>
                                <col t-if="account_move.sd_show_cash_flow" style="width:14%"/>
                                <col t-if="account_move.sd_show_analytic" style="width:14%"/>
                                <col t-if="account_move.sd_is_fecha" style="width:10%"/>
                                <col style="width:8%"/>
                                <col style="width:8%"/>
                            </colgroup>
                            <thead>
                                <tr style="height:20px;">
                                    <th style="border-right:1px solid #000000; padding:2px;">CUENTA</th>
                                    <th style="border-right:1px solid #000000; padding:2px;">EMPRESA</th>
                                    <th style="border-right:1px solid #000000; padding:2px;">DESCRIPCION</th>
                                    <th t-if="account_move.sd_show_cash_flow" style="border-right:1px solid #000000; padding:2px;">CTA FLUJO</th>
                                    <th t-if="account_move.sd_show_analytic" style="border-right:1px solid #000000; padding:2px;">ANALITICA</th>
                                    <th t-if="account_move.sd_is_fecha" style="border-right:1px solid #000000; padding:2px;">FECHA</th>
                                    <th style="border-right:1px solid #000000; padding:2px;">DEBE</th>
                                    <th style="padding:2px;">HABER</th>
                                </tr>
                            </thead>
                        </table>
                    </div>

                    <div class="page" style="border-left:1px solid #000000;border-right:1px solid #000000;">
                        <t t-set="sd_lines" t-value="account_move.line_ids if account_move.sd_is_fecha else account_move.return_order_line_ids()"/>
                        <table style="width:100%; table-layout:fixed; border-collapse:collapse; font-size:11px; text-transform:uppercase;">
                            <colgroup>
                                <col style="width:17%"/>
                                <col style="width:11%"/>
                                <col style="width:18%"/>
                                <col t-if="account_move.sd_show_cash_flow" style="width:14%"/>
                                <col t-if="account_move.sd_show_analytic" style="width:14%"/>
                                <col t-if="account_move.sd_is_fecha" style="width:10%"/>
                                <col style="width:8%"/>
                                <col style="width:8%"/>
                            </colgroup>
                            <tbody>
                                <t t-foreach="sd_lines" t-as="line">
                                    <tr style="height:45px; line-height:96%;">
                                        <td style="border-right:1px solid #000000; padding:5px 4px; vertical-align:middle; word-wrap:break-word;">
                                            <span t-att-style="style" t-esc="line.account_id.display_name"/>
                                        </td>
                                        <td style="border-right:1px solid #000000; padding:5px 4px; vertical-align:middle; word-wrap:break-word;">
                                            <span t-att-style="style" t-esc="line.partner_id.name or ''"/>
                                        </td>
                                        <td style="border-right:1px solid #000000; padding:5px 4px; vertical-align:middle; word-wrap:break-word;">
                                            <span t-att-style="style" t-esc="line.name or ''"/>
                                        </td>
                                        <td t-if="account_move.sd_show_cash_flow" style="border-right:1px solid #000000; padding:5px 4px; vertical-align:middle; word-wrap:break-word;">
                                            <span t-esc="line.esi_cash_flow_id.display_name if line.esi_cash_flow_id else ''"/>
                                        </td>
                                        <td t-if="account_move.sd_show_analytic" style="border-right:1px solid #000000; padding:5px 4px; vertical-align:middle; word-wrap:break-word;">
                                            <span t-esc="line.analytic_account_id.display_name if line.analytic_account_id else ''"/>
                                        </td>
                                        <!-- Se conserva el comportamiento ORIGINAL de la version 1:
                                             Columna Fecha imprime date_maturity. -->
                                        <td t-if="account_move.sd_is_fecha" style="border-right:1px solid #000000; padding:5px 3px; vertical-align:middle; text-align:center;">
                                            <span t-att-style="style" t-esc="line.date_maturity"/>
                                        </td>
                                        <td style="border-right:1px solid #000000; padding:5px 3px; vertical-align:middle; text-align:right;">
                                            <span t-att-style="style" t-esc="line.debit" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                        <td style="padding:5px 3px; vertical-align:middle; text-align:right;">
                                            <span t-att-style="style" t-esc="line.credit" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                    </tr>
                                </t>

                                <t t-foreach="account_move.get_return_total_linea_add()" t-as="item">
                                    <tr style="height:45px;">
                                        <td style="border-right:1px solid #000000;"></td>
                                        <td style="border-right:1px solid #000000;"></td>
                                        <td style="border-right:1px solid #000000;"></td>
                                        <td t-if="account_move.sd_show_cash_flow" style="border-right:1px solid #000000;"></td>
                                        <td t-if="account_move.sd_show_analytic" style="border-right:1px solid #000000;"></td>
                                        <td t-if="account_move.sd_is_fecha" style="border-right:1px solid #000000;"></td>
                                        <td style="border-right:1px solid #000000;"></td>
                                        <td></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div class="footer" style="border:1px solid #000000; position:relative;z-index:10">
                         <div style="width:100%; height:125px;font-size: 12px;border-bottom:1px solid #000000">
                            <div style="width:76%;float:left;height:100%;border-right:1px solid #000000;padding-left:1%;padding-right:1%;">
                                <div style="width:90%;height:34%;float:left">
                                    SON: <span t-esc="account_move.numero_to_letras(account_move.result_total_debit())"/>
                                </div>
                                <div style="width:10%;height:17%;float:right;text-align: right;"> Total Bs.</div>
                                <div style="width:10%;height:17%;float:right;text-align: right;"> Total $us.</div>
                            </div>
                            <div style="width:12%;float:left;height:100%;border-right:1px solid #000000;padding-right:1%;text-align:right;">
                                <span t-esc="account_move.result_total_debit()" t-options='{"widget": "float", "precision": 2}'/>
                            </div>
                            <div style="width:12%;float:right;height:100%;text-align:right;padding-right:1%;">
                                <span t-esc="account_move.result_total_credit()" t-options='{"widget": "float", "precision": 2}'/>
                            </div>
                        </div>
                        <div style="width:100%; height:125px;font-size: 12px">
                            <div style="width:25%;float:left;height:85%;border:1px solid #85929E;margin-left:70px;margin-top:10px;margin-bottom:2px;border-radius: 2px;">
                                <div style="width:96%; height:80%;border-bottom:1px solid #000000;margin-left:2%;margin-right:2%"></div>
                                <div style="width:100%; height:20%;font-size: 12px;"><center>ELABORADO POR</center></div>
                            </div>
                            <div style="width:25%;float:left;height:85%;border:1px solid #85929E;margin-left:35px;margin-top:10px;margin-bottom:2px;border-radius: 2px;">
                                <div style="width:96%; height:80%;border-bottom:1px solid #000000;margin-left:2%;margin-right:2%"></div>
                                <div style="width:100%; height:20%;font-size: 12px;"><center>GERENTE GENERAL</center></div>
                            </div>
                            <div style="width:25%;float:left;height:85%;border:1px solid #85929E;margin-left:35px;margin-top:10px;margin-bottom:2px;border-radius: 2px;">
                                <div style="width:96%; height:80%;border-bottom:1px solid #000000;margin-left:2%;margin-right:2%"></div>
                                <div style="width:100%; height:20%;font-size: 12px;"><center>CONTADOR</center></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="sd_reporte_formato_papel_account_move_comprobante" model="report.paperformat">
        <field name="name">Comprobante contable</field>
        <field name="default" eval="True" />
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">60</field>
        <field name="margin_bottom">86</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">27</field>
        <field name="dpi">96</field>
        <field name="report_ids" eval="[(4, ref('sd_comprobantes_contable.sd_action_account_move_comprobantes'))]"/>
    </record>
</odoo>

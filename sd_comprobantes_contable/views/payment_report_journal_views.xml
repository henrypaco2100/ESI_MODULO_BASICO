<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_move_journal_report" model="ir.ui.view">
            <field name="name">account.move.journal.report</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="before">
                    <field string="Tipo de Cambio" name="tipo_cambio" attrs="{'invisible': 1}"/>
                    <field string="Elaborado" name="elaborate" attrs="{'invisible': 1}"/>
                    <field string="Autorizado" name="autorizate" attrs="{'invisible': 1}"/>
                    <field string="Interesado" name="elaborate" attrs="{'invisible': 1}"/>
                </field>
            </field>
        </record>
    </data>
</odoo>

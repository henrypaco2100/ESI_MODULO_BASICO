<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_sale_payment_wizard_form" model="ir.ui.view">
        <field name="name">esi.sale.payment.wizard.form</field>
        <field name="model">esi.sale.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar Pago">
                <div class="alert alert-info" role="alert">
                    <strong>ESI:</strong> el pago se aplicará directamente a la factura seleccionada.
                </div>
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="invoice_choice"/>
                    <field name="partner_id"/>
                    <field name="journal_choice"/>
                    <field name="amount_due"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="payment_date"/>
                    <field name="communication"/>
                </group>
                <footer>
                    <button name="action_register_payment" type="object" string="Registrar Pago" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

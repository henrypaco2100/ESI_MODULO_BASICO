<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ESI: se conserva el XML-ID del asset histórico únicamente para que,
         al actualizar una base existente, la personalización CSS antigua quede
         desactivada. El nuevo módulo no necesita estilos ni botones especiales. -->
    <template id="mystyle_assets_automated"
              name="Tipo de Ventas - assets antiguos desactivados"
              inherit_id="web.assets_backend"
              active="False">
        <xpath expr="." position="inside"/>
    </template>
</odoo>

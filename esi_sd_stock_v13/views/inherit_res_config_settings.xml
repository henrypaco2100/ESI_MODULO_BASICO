<!-- Modificaciones en el Formulario de contactos-->
<odoo>
    <data>
        <record model="ir.ui.view" id="sd_inherit_res_config_settings">
            <field name="name">sd_inherit_res_config_settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@data-key='stock']" position="inside">
                    <h2>Extras SO</h2>
                    <div class="row mt16 o_settings_container" name="sd_div_filter_uom_inhertit">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="sd_filter_uom"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <spam><strong>Filtrar Unidades de Medida</strong></spam>
                                <div class="text-muted">
                                    Selecciona solo las unidades de medida que corresponden al producto
                                </div>
                            </div>
                        </div>
                    </div>


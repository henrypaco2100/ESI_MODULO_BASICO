<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_calzados_demo_loader_form" model="ir.ui.view">
        <field name="name">esi.calzados.demo.loader.form</field>
        <field name="model">esi.calzados.demo.loader</field>
        <field name="arch" type="xml">
            <form string="ESI - Cargar Demo Calzados">
                <sheet>
                    <div class="oe_title">
                        <h1>Demo ESI Calzados v13</h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="create_manufacturing_orders"/>
                    </group>
                    <group string="Qué se creará / actualizará">
                        <div>3 productos terminados con variantes de Talla y Color.</div>
                        <div>3 listas de materiales y materias primas con costos.</div>
                        <div>AVCO + valoración automática y Producción en Proceso 154000.</div>
                        <div>Cuentas analíticas por producto terminado.</div>
                        <div>Actividades y registros de destajo sin tiempos.</div>
                    </group>
                    <group attrs="{'invisible':[('result','=',False)]}">
                        <field name="result" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_load_demo" string="CREAR / ACTUALIZAR DEMO" type="object" class="btn-primary"/>
                    <button name="action_open_demo_mos" string="Ver OF Demo" type="object" class="btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_esi_calzados_demo_loader" model="ir.actions.act_window">
        <field name="name">ESI Demo Calzados</field>
        <field name="res_model">esi.calzados.demo.loader</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_esi_calzados_demo_loader_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_esi_calzados_demo_loader"
              name="ESI Demo Calzados"
              parent="mrp.menu_mrp_configuration"
              action="action_esi_calzados_demo_loader"
              sequence="95"
              groups="mrp.group_mrp_manager"/>
</odoo>

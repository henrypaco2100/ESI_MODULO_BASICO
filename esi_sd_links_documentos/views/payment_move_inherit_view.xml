<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record model="ir.ui.view" id="inherit_view_account_payment_form">
        <field name="name">inherit.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="sd_tipo" invisible="1"/>
                    <button name="action_get_account_moves" icon="fa-usd" class="oe_stat_button"
                            string="Asientos Contables" type="object" groups="account.group_account_user"/>
<!--                    <button name="action_get_factura" icon="fa-plus" class="oe_stat_button"-->
<!--                            string="Factura" type="object" attrs="{'invisible':[('move_reconciled', '=', 'False')]}"/>-->
                    <button name="action_get_compra" icon="fa-signal" class="oe_stat_button"
                            string="Compra" type="object" attrs="{'invisible':[('sd_tipo', '!=', 'compra')]}"/>
                    <button name="action_get_venta" icon="fa-signal" class="oe_stat_button"
                            string="Venta" type="object" attrs="{'invisible':[('sd_tipo', '!=', 'venta')]}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>

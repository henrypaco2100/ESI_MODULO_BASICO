<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de Compra-->
<odoo>
   <data>
    <record model="ir.ui.view" id="purchase_order_ocultar_button_confirmar">
            <field name="name">purchase.order.hide.button.confirmar</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- ocultar el boton "confimar pedido"
                existen 2 button con el mismo nombre, primero modificamos el nombre(name) de uno
                para luego ocultar ambos-->
                 <xpath expr="//button[@name='button_confirm']" position="attributes">
                    <attribute name='name'>button_confirm1</attribute>
                     <attribute name='invisible'>1</attribute>
                </xpath>
                <xpath expr="//button[@name='button_confirm']" position="attributes">
                    <attribute name='invisible'>1</attribute>
                </xpath>
                <!-- VOlvemos el button a su nombre original-->
                <xpath expr="//button[@name='button_confirm1']" position="attributes">
                    <attribute name='name'>button_confirm</attribute>
                </xpath>
                <!-- editar la class del button "Enviar por Email"-->
                <xpath expr="//button[@name='action_rfq_send']" position="attributes">
                    <attribute name='class'>btn-light</attribute>
                </xpath>

                <!-- ocultar el button "Imprimir SD"-->
                <xpath expr="//button[@name='print_quotation']" position="attributes">
                    <attribute name='invisible'>1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
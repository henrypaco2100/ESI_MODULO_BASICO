<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de Inventario Transferencia-->
<odoo>
   <data>
    <record model="ir.ui.view" id="stock_picking_ocultar_campos_transferencia">
            <field name="name">stock.picking.hide.field.origen.destino</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- ocultamos los campos "ubicacion origen" y "ubicacion destino"-->
                <xpath expr="//field[@name='location_id']" position="attributes">
                    <attribute name='readonly'>1</attribute>
                </xpath>
                <xpath expr="//field[@name='location_dest_id']" position="attributes">
                    <attribute name='readonly'>1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
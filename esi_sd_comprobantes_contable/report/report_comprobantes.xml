<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Un único reporte visible. El formato se elige desde Contabilidad > Configuración. -->
    <report
        id="sd_action_account_move_comprobantes"
        model="account.move"
        string="Comprobante Contable"
        report_type="qweb-pdf"
        name="esi_sd_comprobantes_contable.sd_report_account_move_comprobante_contable"
        file="esi_sd_comprobantes_contable.report_account_move"
        print_report_name="(object.get_nombre_file_report_comprobante_contable())"
    />
    <record id="sd_action_account_move_comprobantes" model="ir.actions.report">
        <field name="groups_id" eval="[(5, 0, 0)]"/>
    </record>

    <report
        id="sd_action_account_payment_comprobantes"
        model="account.payment"
        string="Comprobante Contable"
        report_type="qweb-pdf"
        name="esi_sd_comprobantes_contable.payment_journal_pdf_report_pagos"
        file="esi_sd_comprobantes_contable.report_account_payment"
        print_report_name="(object.get_nombre_file_report_comprobante_contable())"
    />
    <record id="sd_action_account_payment_comprobantes" model="ir.actions.report">
        <field name="groups_id" eval="[(5, 0, 0)]"/>
    </record>

    <!-- Acciones antiguas v2: se conservan por XML-ID para compatibilidad, pero
         quedan sin vínculo al menú Imprimir para evitar opciones duplicadas. -->
    <record id="sd_action_account_payment_version_2" model="ir.actions.report">
        <field name="name">Comprobante Contable (Legado v2)</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">esi_sd_comprobantes_contable.sd_report_account_payment_version_2</field>
        <field name="report_file">esi_sd_comprobantes_contable.sd_report_account_payment_version_2</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="sd_action_account_move_comprobantes_version_2" model="ir.actions.report">
        <field name="name">Comprobante Contable (Legado v2)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">esi_sd_comprobantes_contable.sd_report_account_move_comprobante_contable_version_2</field>
        <field name="report_file">esi_sd_comprobantes_contable.sd_report_account_move_comprobante_contable_version_2</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="sd_internal_layout_account_move_comprobante">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
    </template>

    <template id="sd_internal_layout_account_payment_comprobantes_contable">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
    </template>

    <template id="sd_internal_layout_account_payment_version_2">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
    </template>

    <template id="sd_internal_layout_account_move_comprobante_version_2">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sd_view_account_move_report_comprobante_contable" model="ir.ui.view">
            <field name="name">account.move.journal.report</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!--
                    ESI correccion 2026-09-01:
                    Las opciones de impresion se agrupan en Otra informacion,
                    sin mezclar configuraciones del comprobante con campos
                    contables estandar de Odoo.
                -->
                <xpath expr="//page[@name='other_info']/group[@id='other_tab_entry_group']" position="after">
                    <group string="Comprobante Contable" name="sd_comprobante_contable_group">
                        <group>
                            <field name="sd_is_fecha" widget="boolean"/>
                            <field name="sd_show_cash_flow" widget="boolean"/>
                            <field name="sd_show_analytic" widget="boolean"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

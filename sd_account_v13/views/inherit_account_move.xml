<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de contactos-->
<odoo>
    <data>
        <record model="ir.ui.view" id="sd_inherit_account_move_mejoras_form">
            <field name="name">sd_inherit_account_move_mejoras_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="ref" position="after">
<!--                    <field name="sd_show_glosa"/>-->
                    <field name="sd_glosa" attrs="{'invisible':[('type','!=','entry')]}"/>
<!--                    <field name="sd_tipo_movimiento" attrs="{'invisible':[('type','!=','entry')]}"/>-->
                </field>


                <field name="date" position="after">
                    <field name="sd_tiene_contabilidad_completa" invisible="1"/>
                </field>
                <field name="currency_id" position="attributes">
                    <attribute name="options">{'not_create':True,'no_create_edit':True}</attribute>
                </field>
                <field name="invoice_payment_term_id" position="attributes">
                    <attribute name="options">{'not_create':True,'no_create_edit':True}</attribute>
                </field>
                <xpath expr="/form/sheet/notebook/page/field/tree/field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/notebook/page/field/tree/field[@name='account_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/notebook/page[@id='aml_tab']/field/tree/field[@name='account_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
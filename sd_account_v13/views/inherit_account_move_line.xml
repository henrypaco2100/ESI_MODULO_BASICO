       <record model="ir.ui.view" id="sd_inherit_account_move_line_form_grupo_financiero">
            <field name="name">sd_inherit_account_move_line_form_grupo_financiero</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='account_id']" position="after">
                    <field name="sd_grupo_financiero"/>
                </xpath>
            </field>
        </record>
       <record model="ir.ui.view" id="sd_inherit_account_move_line_tree_grupo_financiero">
            <field name="name">sd_inherit_account_move_line_tree_grupo_financiero</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='account_id']" position="after">
                    <field name="sd_grupo_financiero" optional="hide"/>
                </xpath>
            </field>
        </record>
       <record model="ir.ui.view" id="sd_inherit_account_move_line_search">
            <field name="name">sd_inherit_account_move_line_search</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_account_move_line_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="inside">
                    <filter string="Grupo Cuenta" name="group_by_grupo_financiero" domain="[]" context="{'group_by': 'sd_grupo_financiero'}"/>
                    <filter string="Compañia" name="group_by_compañia" domain="[]" context="{'group_by': 'company_id'}"/>
                </xpath>
            </field>
        </record>
   </data>
</odoo>


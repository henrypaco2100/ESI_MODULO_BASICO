   <data>
        <record model="ir.ui.view" id="sd_inherit_account_move_lines_enter_account_form">
            <field name="name">sd_inherit_account_move_lines_mejoras_form</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree_grouped"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="before">
                    <button name="action_view_account_move" type="object" class="btn btn-primary" string="Ver"/>
                </xpath>
                <xpath expr="//field[@name='credit']" position="after">
                    <field name="sd_saldo" optional="show" sum="Total Saldo" widget="Monetary"/>
                </xpath>
            </field>
        </record>

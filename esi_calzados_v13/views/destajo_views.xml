<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_calzado_destajo_activity_tree" model="ir.ui.view">
        <field name="name">esi.calzado.destajo.actividad.tree</field>
        <field name="model">esi.calzado.destajo.actividad</field>
        <field name="arch" type="xml">
            <tree string="Actividades de destajo">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="default_unit_price"/>
                <field name="expense_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_esi_calzado_destajo_activity_form" model="ir.ui.view">
        <field name="name">esi.calzado.destajo.actividad.form</field>
        <field name="model">esi.calzado.destajo.actividad</field>
        <field name="arch" type="xml">
            <form string="Actividad de destajo">
                <sheet>
                    <group>
                        <group><field name="name"/><field name="code"/><field name="sequence"/></group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="default_unit_price"/>
                            <field name="expense_account_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group><field name="notes"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_esi_calzado_destajo_search" model="ir.ui.view">
        <field name="name">esi.calzado.destajo.search</field>
        <field name="model">esi.calzado.destajo</field>
        <field name="arch" type="xml">
            <search string="Buscar destajos">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="activity_id"/>
                <field name="date"/>
                <field name="analytic_account_id"/>
                <filter string="Borrador" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmado" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Pagado" name="paid" domain="[('state','=','paid')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Operador" name="group_by_partner" domain="[]" context="{'group_by':'partner_id'}"/>
                    <filter string="Actividad" name="group_by_activity" domain="[]" context="{'group_by':'activity_id'}"/>
                    <filter string="Producto" name="group_by_product" domain="[]" context="{'group_by':'product_id'}"/>
                    <filter string="Fecha" name="group_by_date" domain="[]" context="{'group_by':'date'}"/>
                    <filter string="Estado" name="group_by_state" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_esi_calzado_destajo_tree" model="ir.ui.view">
        <field name="name">esi.calzado.destajo.tree</field>
        <field name="model">esi.calzado.destajo</field>
        <field name="arch" type="xml">
            <tree string="Lista de destajos">
                <field name="name"/>
                <field name="date"/>
                <field name="product_id" optional="show"/>
                <field name="partner_id"/>
                <field name="activity_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="unit_price"/>
                <field name="amount" sum="Total destajos"/>
                <field name="expense_account_id" optional="show"/>
                <field name="analytic_account_id" optional="hide"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_esi_calzado_destajo_form" model="ir.ui.view">
        <field name="name">esi.calzado.destajo.form</field>
        <field name="model">esi.calzado.destajo</field>
        <field name="arch" type="xml">
            <form string="Registro de destajo">
                <header>
                    <button name="action_confirm" string="Confirmar y contabilizar gasto" type="object" class="oe_highlight" states="draft"/>
                    <button name="action_paid" string="Marcar pagado" type="object" class="oe_highlight" states="confirmed"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="production_id" invisible="1"/>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" name="action_view_account_move" type="object" icon="fa-book" attrs="{'invisible':[('account_move_id','=',False)]}">
                            <div class="o_stat_info"><span class="o_stat_text">Asiento</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Trabajo realizado">
                            <field name="date" attrs="{'readonly':[('state','!=','draft')]}"/>
                            <field name="partner_id" attrs="{'readonly':[('state','!=','draft')]}"/>
                            <field name="activity_id" attrs="{'readonly':[('state','!=','draft')]}"/>
                            <field name="product_id" attrs="{'readonly':[('state','!=','draft')]}"/>
                            <field name="description" attrs="{'readonly':[('state','!=','draft')]}"/>
                        </group>
                        <group string="Gasto / Contabilidad">
                            <field name="currency_id" invisible="1"/>
                            <field name="expense_account_id" attrs="{'readonly':[('state','!=','draft')]}"/>
                            <field name="analytic_account_id" attrs="{'readonly':[('state','!=','draft')]}"/>
                            <field name="account_move_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Importe del destajo">
                        <group><field name="quantity" attrs="{'readonly':[('state','!=','draft')]}"/><field name="uom_id" attrs="{'readonly':[('state','!=','draft')]}"/></group>
                        <group><field name="unit_price" attrs="{'readonly':[('state','!=','draft')]}"/><field name="amount" readonly="1"/></group>
                    </group>
                    <group><field name="notes"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esi_calzado_destajo" model="ir.actions.act_window">
        <field name="name">Lista de destajos</field>
        <field name="res_model">esi.calzado.destajo</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_esi_calzado_destajo_search"/>
    </record>
    <record id="action_esi_calzado_destajo_form" model="ir.actions.act_window">
        <field name="name">Registrar destajo</field>
        <field name="res_model">esi.calzado.destajo</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_esi_calzado_destajo_form"/>
        <field name="target">current</field>
    </record>
    <record id="action_esi_calzado_destajo_activity" model="ir.actions.act_window">
        <field name="name">Actividades de destajo</field>
        <field name="res_model">esi.calzado.destajo.actividad</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Se conserva en Datos principales. Ya no existe vínculo obligatorio con una OF. -->
    <menuitem id="menu_esi_calzado_destajo_list" name="Lista de destajos" parent="mrp.menu_mrp_bom" action="action_esi_calzado_destajo" sequence="20" groups="mrp.group_mrp_user"/>
    <menuitem id="menu_esi_calzado_destajo_form" name="Registrar destajo" parent="mrp.menu_mrp_bom" action="action_esi_calzado_destajo_form" sequence="21" groups="mrp.group_mrp_user"/>
    <menuitem id="menu_esi_calzado_destajo_activity" name="Actividades de destajo" parent="mrp.menu_mrp_bom" action="action_esi_calzado_destajo_activity" sequence="22" groups="mrp.group_mrp_manager"/>
</odoo>

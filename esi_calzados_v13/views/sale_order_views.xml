<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_esi_calzados" model="ir.ui.view">
        <field name="name">sale.order.form.esi.calzados</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_esi_production_groups" type="object" icon="fa-industry"
                        attrs="{'invisible':[('esi_production_group_count','=',0)]}">
                    <field name="esi_production_group_count" widget="statinfo" string="Grupos producción"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="esi_production_manager_id"/>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][1]" position="after">
                <button name="action_esi_prepare_production_group" type="object"
                        string="Crear lista de producción" class="btn-secondary"
                        attrs="{'invisible':[('state','=','cancel')]}"/>
            </xpath>
        </field>
    </record>
</odoo>

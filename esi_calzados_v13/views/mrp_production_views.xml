<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_esi_calzados" model="ir.ui.view">
        <field name="name">mrp.production.form.esi.calzados</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_esi_open_purchase_wizard" type="object" icon="fa-shopping-cart">
                    <field name="esi_missing_line_count" widget="statinfo" string="Faltantes"/>
                </button>
                <button class="oe_stat_button" name="action_view_esi_account_moves" type="object" icon="fa-book">
                    <field name="esi_account_move_count" widget="statinfo" string="Asientos"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="esi_variant_info" readonly="1"/>
                <field name="esi_analytic_account_id"/>
                <field name="esi_production_group_id" readonly="1"/>
                <field name="esi_sale_order_id" readonly="1" attrs="{'invisible':[('esi_sale_order_id','=',False)]}"/>
                <field name="esi_customer_id" readonly="1" attrs="{'invisible':[('esi_customer_id','=',False)]}"/>
                <field name="esi_salesperson_id" readonly="1" attrs="{'invisible':[('esi_salesperson_id','=',False)]}"/>
                <field name="esi_production_manager_id" readonly="1" attrs="{'invisible':[('esi_production_manager_id','=',False)]}"/>
            </xpath>

            <xpath expr="//notebook" position="before">
                <group string="Costos de producción ESI" col="4">
                    <field name="currency_id" invisible="1"/>
                    <field name="esi_material_cost" readonly="1"/>
                    <field name="esi_other_cost"/>
                    <field name="esi_total_estimated_cost" readonly="1"/>
                    <field name="esi_unit_estimated_cost" readonly="1"/>
                    <field name="esi_missing_cost" readonly="1"/>
                    <field name="esi_wip_material_amount" readonly="1"/>
                    <field name="esi_wip_registered" readonly="1"/>
                    <field name="esi_wip_registered_date" readonly="1" attrs="{'invisible': [('esi_wip_registered', '=', False)]}"/>
                    <field name="esi_wip_material_move_id" invisible="1"/>
                    <button name="action_esi_refresh_material_costs" type="object" string="Actualizar costos materiales" class="btn-secondary"/>
                    <button name="action_esi_sync_wip_provisional" type="object" string="Actualizar Producción en Proceso" class="btn-secondary"
                            attrs="{'invisible': [('state', 'in', ('draft', 'done', 'cancel'))]}"/>
                </group>
            </xpath>

            <xpath expr="//header/button[@name='action_assign']" position="after">
                <button name="action_esi_open_purchase_wizard" type="object" string="Preparar compra faltantes"
                        class="btn-secondary" attrs="{'invisible': [('state', 'in', ('done', 'cancel'))]}"/>
            </xpath>
        </field>
    </record>


    <record id="view_mrp_production_tree_esi_group" model="ir.ui.view">
        <field name="name">mrp.production.tree.esi.group</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="esi_production_group_id" optional="show"/>
                <field name="esi_customer_id" optional="hide"/>
                <field name="esi_salesperson_id" optional="hide"/>
                <field name="esi_production_manager_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_raw_tree_esi_calzados" model="ir.ui.view">
        <field name="name">stock.move.raw.tree.esi.calzados</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="mrp.view_stock_move_raw_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="esi_material_group" optional="show"/>
                <field name="esi_qty_per_unit" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Cant. total requerida</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="esi_unit_cost" optional="show"/>
                <field name="esi_unit_material_cost" optional="show"/>
                <field name="esi_total_material_cost" optional="show"/>
                <field name="esi_available_qty" optional="show"/>
                <field name="esi_missing_qty" optional="show"/>
                <field name="esi_purchase_unit_cost" optional="hide"/>
                <field name="esi_missing_cost" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_calzado_purchase_request_wizard" model="ir.ui.view">
        <field name="name">esi.calzado.purchase.request.wizard.form</field>
        <field name="model">esi.calzado.purchase.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Materiales faltantes / Preparar compra">
                <sheet>
                    <group><field name="production_id" readonly="1"/><field name="currency_id" invisible="1"/><field name="total_estimated" readonly="1"/></group>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="move_id" invisible="1" force_save="1"/>
                            <field name="selected"/>
                            <field name="product_id" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="required_qty" readonly="1"/>
                            <field name="available_qty" readonly="1"/>
                            <field name="missing_qty" readonly="1"/>
                            <field name="vendor_id"/>
                            <field name="unit_price"/>
                            <field name="subtotal" readonly="1" sum="Total"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_rfqs" string="Crear RFQ por proveedor" type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

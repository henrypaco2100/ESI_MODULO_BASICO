<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sd_form_inherit_stock_picking_mejoras">
             <field name="name">sd_form_inherit_stock_picking_mejoras</field>
             <field name="model">stock.picking</field>
             <field name="inherit_id" ref="stock.view_picking_form"/>
             <field name="arch" type="xml">
                 <field name="picking_type_id" position="attributes">
                     <attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
                 </field>
                 <field name="product_uom_qty" position="after">
                     <field name="sd_stock_disponible"/>
                 </field>
                 <field name="origin" position="after">
                     <field name="sd_porcentaje"/>
                 </field>
                 <field name="product_id" position="attributes">
                     <attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
                 </field>
             </field>
        </record>
    </data>
    <data>
        <record model="ir.ui.view" id="sd_form_inherit_stock_picking_stock_move_line_detailed_operation_tree_mejoras">
             <field name="name">sd_form_inherit_stock_picking_stock_move_line_detailed_operation_tree_mejoras</field>
             <field name="model">stock.move.line</field>
             <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
             <field name="arch" type="xml">
                 <field name="product_uom_qty" position="before">
                     <field name="sd_stock_disponible"/>
                 </field>
             </field>
        </record>
    </data>
</odoo>